{
  "manifest_version": 3,
  "name": "本地实时字幕",
  "version": "1.0.0",
  "description": "通过本机语音识别与 Hy-MT2 实时显示翻译字幕",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "本地实时字幕"
  }
}
